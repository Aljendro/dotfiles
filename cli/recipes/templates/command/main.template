(ns aljendro.cli.commands.{{ name }}.main
  (:require
   [clojure.tools.cli :refer [parse-opts]]))

(def ^:private options
  [["-h" "--help" "Show help"]])

(defn ^:async run [args]
  (let [{:keys [options errors]} (parse-opts args options)
        {help :help} options]
    (cond
      help
      (println "Usage: t {{ name }}")

      errors
      (do (doseq [e errors] (println e))
          (js/process.exit 1))

      :else
      (println "Running {{ name }}"))))
